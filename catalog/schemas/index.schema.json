{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "generatedAt": {
      "type": "string"
    },
    "bucket": {
      "type": "string"
    },
    "counts": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^([a-z]+)\\.([a-z0-9]+(?:-[a-z0-9]+)*)\\.([a-z0-9]+(?:-[a-z0-9]+)*)\\.v([1-9][0-9]*)$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "brand",
              "font",
              "zee",
              "face",
              "selfie",
              "tryon",
              "garment",
              "photo",
              "stock",
              "footage",
              "screenshot",
              "music",
              "sfx",
              "voice",
              "reference",
              "device"
            ]
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "approved",
              "retired"
            ]
          },
          "manifest": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "default": "original",
                  "type": "string",
                  "enum": [
                    "original",
                    "cutout",
                    "thumb",
                    "frame",
                    "proof",
                    "stem"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 3
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "mime": {
                  "type": "string"
                },
                "s3Key": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "sha256",
                "bytes",
                "s3Key"
              ]
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "licence": {
            "type": "string"
          },
          "aiGenerated": {
            "type": "boolean"
          },
          "asset": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "status",
          "manifest",
          "files",
          "tags",
          "licence",
          "aiGenerated",
          "asset"
        ]
      }
    }
  },
  "required": [
    "generatedAt",
    "bucket",
    "counts",
    "assets"
  ]
}
