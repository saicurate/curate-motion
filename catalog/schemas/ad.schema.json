{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string"
    },
    "brief": {
      "type": "string"
    },
    "hook": {
      "type": "string"
    },
    "channels": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "tiktok",
          "reels",
          "shorts",
          "meta-feed",
          "youtube",
          "appstore",
          "website",
          "x"
        ]
      }
    },
    "formats": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "9x16",
          "4x5",
          "1x1",
          "16x9",
          "appstore-iphone",
          "appstore-ipad"
        ]
      }
    },
    "lengths": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "fps": {
      "default": 30,
      "anyOf": [
        {
          "type": "number",
          "const": 24
        },
        {
          "type": "number",
          "const": 30
        },
        {
          "type": "number",
          "const": 60
        }
      ]
    },
    "track": {
      "type": "string",
      "pattern": "^([a-z]+)\\.([a-z0-9]+(?:-[a-z0-9]+)*)\\.([a-z0-9]+(?:-[a-z0-9]+)*)\\.v([1-9][0-9]*)$"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([a-z]+)\\.([a-z0-9]+(?:-[a-z0-9]+)*)\\.([a-z0-9]+(?:-[a-z0-9]+)*)\\.v([1-9][0-9]*)$"
      }
    },
    "components": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "idea",
        "draft",
        "review",
        "approved",
        "live",
        "retired"
      ]
    },
    "approvedBy": {
      "type": "string"
    },
    "approvedAt": {
      "type": "string"
    },
    "disclosures": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "voice": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "captions",
            "human",
            "tts"
          ]
        },
        "captions": {
          "type": "object",
          "properties": {
            "preset": {
              "default": "brand-keyphrase",
              "type": "string"
            },
            "burnIn": {
              "default": true,
              "type": "boolean"
            },
            "sidecar": {
              "default": [
                "srt",
                "vtt"
              ],
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "srt",
                  "vtt"
                ]
              }
            }
          }
        },
        "tts": {
          "type": "object",
          "properties": {
            "use": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        },
        "human": {
          "type": "object",
          "properties": {
            "take": {
              "type": "string",
              "pattern": "^([a-z]+)\\.([a-z0-9]+(?:-[a-z0-9]+)*)\\.([a-z0-9]+(?:-[a-z0-9]+)*)\\.v([1-9][0-9]*)$"
            },
            "lines": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^([a-z]+)\\.([a-z0-9]+(?:-[a-z0-9]+)*)\\.([a-z0-9]+(?:-[a-z0-9]+)*)\\.v([1-9][0-9]*)$"
              }
            }
          }
        }
      }
    },
    "createdBy": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "agent",
            "human"
          ]
        },
        "name": {
          "type": "string"
        },
        "at": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "name",
        "at"
      ]
    },
    "notes": {
      "type": "string"
    },
    "gates": {
      "type": "object",
      "properties": {
        "G1": {
          "type": "string",
          "enum": [
            "pending",
            "review",
            "approved",
            "skipped"
          ]
        },
        "G2": {
          "type": "string",
          "enum": [
            "pending",
            "review",
            "approved",
            "skipped"
          ]
        },
        "G3": {
          "type": "string",
          "enum": [
            "pending",
            "review",
            "approved",
            "skipped"
          ]
        },
        "G4": {
          "type": "string",
          "enum": [
            "pending",
            "review",
            "approved",
            "skipped"
          ]
        },
        "G5": {
          "type": "string",
          "enum": [
            "pending",
            "review",
            "approved",
            "skipped"
          ]
        },
        "G6": {
          "type": "string",
          "enum": [
            "pending",
            "review",
            "approved",
            "skipped"
          ]
        }
      },
      "required": [
        "G1",
        "G2",
        "G3",
        "G4",
        "G5",
        "G6"
      ]
    },
    "gateLog": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "gate": {
            "type": "string",
            "enum": [
              "G1",
              "G2",
              "G3",
              "G4",
              "G5",
              "G6"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "review",
              "approved",
              "skipped"
            ]
          },
          "by": {
            "type": "string"
          },
          "byType": {
            "type": "string",
            "enum": [
              "agent",
              "human"
            ]
          },
          "at": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "gate",
          "status",
          "by",
          "byType",
          "at"
        ]
      }
    }
  },
  "required": [
    "id",
    "title",
    "brief",
    "channels",
    "formats",
    "lengths",
    "track",
    "assets",
    "status",
    "createdBy"
  ]
}
