{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "persona": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "uid": {
      "type": "string"
    },
    "env": {
      "type": "string",
      "enum": [
        "prod",
        "staging"
      ]
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}(T[\\d:.]+Z)?$"
    },
    "updatedBy": {
      "type": "string"
    },
    "wardrobe": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "libraryId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^([a-z]+)\\.([a-z0-9]+(?:-[a-z0-9]+)*)\\.([a-z0-9]+(?:-[a-z0-9]+)*)\\.v([1-9][0-9]*)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "photoId": {
            "type": "string"
          },
          "appItemIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "appNames": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "via": {
            "type": "string",
            "enum": [
              "api-add-photo",
              "app-add-item",
              "gallery-scan",
              "manual"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "synced",
              "removed",
              "failed"
            ]
          },
          "at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}(T[\\d:.]+Z)?$"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "libraryId",
          "appItemIds",
          "via",
          "status",
          "at"
        ]
      }
    },
    "unmanaged": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "appItemId": {
            "type": "string"
          },
          "appName": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "appItemId"
        ]
      }
    },
    "cameraRoll": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "device": {
            "type": "string"
          },
          "libraryIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^([a-z]+)\\.([a-z0-9]+(?:-[a-z0-9]+)*)\\.([a-z0-9]+(?:-[a-z0-9]+)*)\\.v([1-9][0-9]*)$"
            }
          },
          "loadedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}(T[\\d:.]+Z)?$"
          },
          "method": {
            "type": "string",
            "enum": [
              "simctl-addmedia",
              "airdrop",
              "manual"
            ]
          }
        },
        "required": [
          "device",
          "libraryIds",
          "loadedAt",
          "method"
        ]
      }
    },
    "spendUsd": {
      "default": 0,
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "persona",
    "uid",
    "env",
    "updatedAt",
    "updatedBy"
  ]
}
