{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "persona": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "displayName": {
      "type": "string"
    },
    "app": {
      "type": "string",
      "const": "curate-ios"
    },
    "env": {
      "type": "string",
      "enum": [
        "prod",
        "staging"
      ]
    },
    "email": {
      "type": "string",
      "format": "email",
      "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
    },
    "signIn": {
      "type": "string",
      "enum": [
        "email-password",
        "email-otp",
        "apple"
      ]
    },
    "uid": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "secret": {
      "type": "object",
      "properties": {
        "store": {
          "type": "string",
          "enum": [
            "aws-ssm",
            "gcp-secret-manager"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^\\/curate\\/marketing\\/[a-z0-9-]+-password$"
        },
        "region": {
          "default": "us-east-1",
          "type": "string"
        }
      },
      "required": [
        "store",
        "name"
      ]
    },
    "flags": {
      "type": "object",
      "properties": {
        "testAccount": {
          "type": "boolean"
        },
        "excludeFromAnalytics": {
          "type": "boolean"
        },
        "origin": {
          "default": "ORGANIC",
          "type": "string",
          "enum": [
            "ORGANIC",
            "SEED"
          ]
        }
      },
      "required": [
        "testAccount",
        "excludeFromAnalytics"
      ]
    },
    "devices": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "simulator",
              "iphone"
            ]
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "name"
        ]
      }
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}(T[\\d:.]+Z)?$"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "active",
        "retired"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "persona",
    "displayName",
    "app",
    "env",
    "signIn",
    "flags",
    "status"
  ]
}
